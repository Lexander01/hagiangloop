rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isGuideOrAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['guide', 'admin'];
    }

    // ── users ────────────────────────────────────────────────────────────────
    match /users/{uid} {
      allow read, write: if isGuideOrAdmin();
    }

    // ── availability ─────────────────────────────────────────────────────────
    match /availability/{date} {
      // Anyone can read (public calendar)
      allow read: if true;
      // Only guides/admins write directly; Cloud Functions use Admin SDK (bypasses rules)
      allow write: if isGuideOrAdmin();
    }

    // ── bookings ─────────────────────────────────────────────────────────────
    match /bookings/{bookingId} {
      // Guides/admins can read all bookings
      allow read: if isGuideOrAdmin();
      // All writes go through the createBooking Cloud Function (Admin SDK),
      // so no client-side write access is needed
      allow write: if false;
    }
  }
}
